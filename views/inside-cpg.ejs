    <!-- =========================================================
         01 BUILD
    ========================================================== -->

    <section
      id="build"
      class="cpg-inside-pillar"
      aria-labelledby="build-heading"
    >

      <div class="cpg-container">


        <header class="cpg-inside-pillar__header">

          <div class="cpg-inside-pillar__index">

            <span>01</span>
            <strong>Build</strong>

          </div>


          <div class="cpg-inside-pillar__title">

            <p class="cpg-inside-eyebrow">
              Experience • Architecture • Performance
            </p>

            <h2 id="build-heading">
              Better Experiences Start Below the Surface.
            </h2>

          </div>

        </header>


        <div class="cpg-inside-value-grid">


          <div class="cpg-inside-value">

            <p class="cpg-inside-label">
              What We Do
            </p>

            <p class="cpg-inside-value__statement">
              We connect UX, development and performance instead of
              treating them as separate problems.
            </p>

