<%
/*
|--------------------------------------------------------------------------
| CPG DEVELOPMENT — GLOBAL <HEAD>
|--------------------------------------------------------------------------
|
| Each page should pass:
|
| title       = Unique page title
| description = Unique meta description
| canonical   = Absolute canonical URL
|
| Optional:
|
| robots      = Robots directive
| ogType      = Open Graph type
| socialImage = Absolute social sharing image URL
| schema      = Page-specific JSON-LD object or array
|
|--------------------------------------------------------------------------
*/

const siteName = 'CPG Development';
const siteUrl = 'https://cpg.dev';

const pageTitle =
  typeof title !== 'undefined' && title
    ? title
    : 'CPG Development | Digital Intelligence, AI & Strategy';

const pageDescription =
  typeof description !== 'undefined' && description
    ? description
    : 'CPG Development helps organizations turn digital data into better business decisions through digital intelligence, AI visibility, analytics, optimization and development.';

const pageCanonical =
  typeof canonical !== 'undefined' && canonical
    ? canonical
    : siteUrl;

const pageRobots =
  typeof robots !== 'undefined' && robots
    ? robots
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const pageOgType =
  typeof ogType !== 'undefined' && ogType
    ? ogType
    : 'website';

const pageSocialImage =
  typeof socialImage !== 'undefined' && socialImage
    ? socialImage
    : siteUrl + '/images/cpg-social.jpg';

const pageSchema =
  typeof schema !== 'undefined'
    ? schema
    : null;
%>

<meta charset="utf-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1"
>

<title><%= pageTitle %></title>

<meta
  name="description"
  content="<%= pageDescription %>"
>

<meta
  name="robots"
  content="<%= pageRobots %>"
>

<meta
  name="googlebot"
  content="<%= pageRobots %>"
>

<link
  rel="canonical"
  href="<%= pageCanonical %>"
>


<!-- ==================================================
     OPEN GRAPH
================================================== -->

<meta property="og:locale" content="en_US">
<meta property="og:type" content="<%= pageOgType %>">
<meta property="og:site_name" content="<%= siteName %>">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:description" content="<%= pageDescription %>">
<meta property="og:url" content="<%= pageCanonical %>">
<meta property="og:image" content="<%= pageSocialImage %>">
<meta
  property="og:image:alt"
  content="CPG Development — Digital Intelligence, AI and Strategy"
>


<!-- ==================================================
     X / TWITTER
================================================== -->

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= pageTitle %>">
<meta name="twitter:description" content="<%= pageDescription %>">
<meta name="twitter:image" content="<%= pageSocialImage %>">
<meta
  name="twitter:image:alt"
  content="CPG Development — Digital Intelligence, AI and Strategy"
>


<!-- ==================================================
     BRAND / BROWSER
================================================== -->

<meta name="theme-color" content="#000000">

<link
  rel="icon"
  href="/images/favicon.ico"
  sizes="any"
>

<link
  rel="apple-touch-icon"
  href="/images/apple-touch-icon.png"
>


<!-- ==================================================
     CONNECTION OPTIMIZATION
================================================== -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link
  rel="preconnect"
  href="https://fonts.gstatic.com"
  crossorigin
>


<!-- ==================================================
     TYPOGRAPHY
================================================== -->

<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
  rel="stylesheet"
>


<!-- ==================================================
     STYLES
================================================== -->

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"
>

<link
  rel="stylesheet"
  href="/stylesheets/cpg.css"
>


<!-- ==================================================
     ORGANIZATION STRUCTURED DATA
================================================== -->

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": siteUrl + "/#organization",
  "name": "CPG Development",
  "url": siteUrl + "/",
  "logo": {
    "@type": "ImageObject",
    "url": siteUrl + "/images/white-text-logo.png"
  },
  "description": "CPG Development helps organizations turn digital data into better business decisions through digital intelligence, AI visibility, analytics, optimization and development."
}) %>
</script>


<!-- ==================================================
     WEBSITE STRUCTURED DATA
================================================== -->

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": siteUrl + "/#website",
  "url": siteUrl + "/",
  "name": "CPG Development",
  "publisher": {
    "@id": siteUrl + "/#organization"
  }
}) %>
</script>


<!-- ==================================================
     PAGE-SPECIFIC STRUCTURED DATA

     Individual EJS pages can pass additional schema
     through the "schema" variable.
================================================== -->

<% if (pageSchema) { %>

<script type="application/ld+json">
<%- JSON.stringify(pageSchema) %>
</script>

<% } %>