<!DOCTYPE html>
<html lang="en">

<head>

  <%- include('partials/head', {
    title: 'CPG Development | Digital Intelligence, AI & Strategy',
    description: 'CPG Development helps organizations turn digital data into better business decisions through digital intelligence, AI visibility, analytics, optimization and development.',
    canonical: 'https://cpg.dev/'
  }) %>

</head>

<body>

  <%- include('partials/header', {
    currentPath: '/'
  }) %>


  <main id="main-content">


    <!-- ==================================================
         HERO
    ================================================== -->

    <section class="hero">

      <div class="container">

        <div class="hero__content">

          <p class="eyebrow">
            Digital Intelligence • AI • Strategy
          </p>

          <h1>
            Turn Your Digital Data Into Better Business Decisions
          </h1>

          <p class="hero__lead">
            CPG Development helps organizations understand digital
            performance, measure visibility across search and AI,
            identify opportunities and turn those insights into
            measurable improvements.
          </p>

          <div class="hero__actions">

            <a
              href="/digital-performance-audit"
              class="button button--primary"
            >
              Get a Digital Performance Audit
            </a>

            <a
              href="#services"
              class="button button--secondary"
            >
              Explore Our Services
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- ==================================================
         SERVICES
    ================================================== -->

    <section
      class="section services"
      id="services"
    >

      <div class="container">

        <div class="section-heading">

          <p class="eyebrow">
            What We Do
          </p>

          <h2>
            From Digital Data to Action
          </h2>

          <p>
            CPG combines analytics, AI visibility, strategy and
            technical implementation to help organizations understand
            what is happening across their digital ecosystem and what
            to do next.
          </p>

        </div>


        <div class="service-grid">


          <article class="service-card">

            <h3>
              Digital Intelligence
            </h3>

            <p>
              Turn analytics and digital performance data into
              understandable insights that support better business
              decisions.
            </p>

            <ul>
              <li>Digital analytics</li>
              <li>Conversion tracking</li>
              <li>Executive dashboards</li>
              <li>Performance measurement</li>
            </ul>

            <a href="/services/digital-intelligence">
              Explore Digital Intelligence
            </a>

          </article>


          <article class="service-card">

            <h3>
              AI Visibility &amp; GEO
            </h3>

            <p>
              Understand how your organization is discovered,
              represented and referenced across AI-driven search
              and generative answer platforms.
            </p>

            <ul>
              <li>AI referral measurement</li>
              <li>Generative engine visibility</li>
              <li>Search and content analysis</li>
              <li>GEO strategy</li>
            </ul>

            <a href="/services/ai-visibility-geo">
              Explore AI Visibility &amp; GEO
            </a>

          </article>


          <article class="service-card">

            <h3>
              Optimization &amp; Development
            </h3>

            <p>
              Turn recommendations into working improvements across
              websites, analytics implementations and digital
              experiences.
            </p>

            <ul>
              <li>Website optimization</li>
              <li>Analytics implementation</li>
              <li>UX improvements</li>
              <li>Custom development</li>
            </ul>

            <a href="/services/optimization-development">
              Explore Optimization &amp; Development
            </a>

          </article>

        </div>

      </div>

    </section>


    <!-- ==================================================
         DIFFERENTIATOR
    ================================================== -->

    <section class="section insight-to-action">

      <div class="container">

        <div class="section-heading">

          <p class="eyebrow">
            Insight to Implementation
          </p>

          <h2>
            We Don't Just Find Problems. We Fix Them.
          </h2>

          <p>
            Analytics are valuable only when they lead to better
            decisions. CPG connects measurement, analysis, strategy
            and implementation so insights can become measurable
            improvements.
          </p>

        </div>


        <ol class="process">

          <li>
            <strong>Measure</strong>
            <span>Collect the right digital signals.</span>
          </li>

          <li>
            <strong>Understand</strong>
            <span>Identify patterns, friction and opportunity.</span>
          </li>

          <li>
            <strong>Recommend</strong>
            <span>Prioritize actions based on evidence.</span>
          </li>

          <li>
            <strong>Implement</strong>
            <span>Turn recommendations into working solutions.</span>
          </li>

          <li>
            <strong>Measure Again</strong>
            <span>Determine what changed and what comes next.</span>
          </li>

        </ol>

      </div>

    </section>


    <!-- ==================================================
         DIGITAL PERFORMANCE AUDIT
    ================================================== -->

    <section class="section audit-callout">

      <div class="container">

        <div class="audit-callout__content">

          <p class="eyebrow">
            Start Here
          </p>

          <h2>
            Digital Performance Audit
          </h2>

          <p>
            Get a focused assessment of your analytics, search
            visibility, AI visibility and digital experience.
            We'll identify what's working, where opportunities
            are being missed and what deserves attention first.
          </p>

          <a
            href="/digital-performance-audit"
            class="button button--primary"
          >
            Learn About the Audit
          </a>

        </div>

      </div>

    </section>


    <!-- ==================================================
         SELECTED WORK
    ================================================== -->

    <section class="section selected-work">

      <div class="container">

        <div class="section-heading">

          <p class="eyebrow">
            Selected Work
          </p>

          <h2>
            Strategy Backed by Implementation
          </h2>

          <p>
            CPG brings together analytics, web development,
            digital strategy and technical problem solving to
            improve how organizations measure and manage their
            digital presence.
          </p>

          <a href="/work">
            View Selected Work
          </a>

        </div>

      </div>

    </section>


    <!-- ==================================================
         FINAL CTA
    ================================================== -->

    <section class="section final-cta">

      <div class="container">

        <div class="final-cta__content">

          <h2>
            Make Your Digital Data More Useful
          </h2>

          <p>
            Start by understanding what your digital ecosystem
            is telling you and where the strongest opportunities
            for improvement exist.
          </p>

          <a
            href="/digital-performance-audit"
            class="button button--primary"
          >
            Get a Digital Performance Audit
          </a>

        </div>

      </div>

    </section>


  </main>


  <%- include('partials/footer') %>


</body>

</html>